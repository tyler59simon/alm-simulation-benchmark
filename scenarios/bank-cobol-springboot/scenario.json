{
  "name": "bank-cobol-springboot",
  "description": "Harbor Point Savings & Trust: modernize a COBOL nightly core-banking batch to Java 21 / Spring Boot 3 with golden-master parity.",
  "domain": "bankmod",
  "sprints": 4,
  "parallel": 4,
  "session_timeout_min": 30,
  "spend_limit_usd": 80,
  "tiers": {
    "haiku": {"model": "haiku", "budget_usd": 1.5, "permission_mode": "bypassPermissions"},
    "sonnet-low": {"model": "sonnet", "effort": "low", "budget_usd": 3.0, "permission_mode": "bypassPermissions"},
    "grader": {"model": "sonnet", "budget_usd": 2.0}
  },
  "roster": [
    {"id": "po", "name": "Priya Okonkwo", "title": "Product Owner / Business Analyst", "tier": "sonnet-low", "briefing": "briefings/po.md"},
    {"id": "arch", "name": "Marcus Lindqvist", "title": "Tech Lead / Architect", "tier": "sonnet-low", "briefing": "briefings/arch.md"},
    {"id": "la1", "name": "Dana Whitfield", "title": "Legacy Analyst (interest, accounts)", "tier": "haiku", "briefing": "briefings/la1.md"},
    {"id": "la2", "name": "Tomas Reyes", "title": "Legacy Analyst (batch flow, ledger, fees)", "tier": "haiku", "briefing": "briefings/la2.md"},
    {"id": "dev-acct", "name": "Aisha Rahman", "title": "Developer, accounts module", "tier": "haiku", "briefing": "briefings/dev-acct.md"},
    {"id": "dev-ledger", "name": "Ben Kowalczyk", "title": "Developer, ledger and posting module", "tier": "haiku", "briefing": "briefings/dev-ledger.md"},
    {"id": "dev-int", "name": "Chen Wei", "title": "Developer, interest module", "tier": "haiku", "briefing": "briefings/dev-int.md", "leaves_after": 2},
    {"id": "dev-pay", "name": "Sofia Marchetti", "title": "Developer, payments and transfers module", "tier": "haiku", "briefing": "briefings/dev-pay.md"},
    {"id": "mig", "name": "Kwame Asante", "title": "Data Migration Engineer", "tier": "haiku", "briefing": "briefings/mig.md"},
    {"id": "qa", "name": "Elena Petrova", "title": "QA Lead (parity and regression)", "tier": "sonnet-low", "briefing": "briefings/qa.md"},
    {"id": "sec", "name": "Raj Malhotra", "title": "Security and Compliance Engineer", "tier": "haiku", "briefing": "briefings/sec.md"},
    {"id": "ops", "name": "Grace Mbeki", "title": "DevOps / Release Engineer", "tier": "haiku", "briefing": "briefings/ops.md"},
    {"id": "dev-int2", "name": "Lucas Ferreira", "title": "Developer, interest module (joined sprint 3)", "tier": "haiku", "briefing": "briefings/dev-int.md", "joins": 3}
  ],
  "waves": [
    ["po", "arch", "la1", "la2"],
    ["dev-acct", "dev-ledger", "dev-int", "dev-int2", "dev-pay", "mig"],
    ["qa", "sec", "ops"]
  ],
  "seed": [
    ["seed/legacy", "legacy"],
    ["seed/modern", "modern"],
    ["seed/team", "team"],
    ["seed/docs", "docs"],
    ["seed/README.md", "README.md"],
    ["seed/gitignore", ".gitignore"]
  ],
  "toolchain": {
    "env": {"JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.13.9-hotspot", "MAVEN_OPTS": "-Xmx1g"},
    "path_prepend": ["C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.13.9-hotspot\\bin"]
  },
  "prime": {"cwd": "modern", "command": ["cmd", "/c", ".\\mvnw.cmd", "-q", "-B", "dependency:go-offline"], "timeout_min": 20},
  "ci": {"cwd": "modern", "command": ["cmd", "/c", ".\\mvnw.cmd", "-q", "-B", "verify"], "timeout_min": 20, "tail_lines": 40},
  "tools": {
    "allow": [
      "Bash(git *)", "Bash(./mvnw *)", "Bash(mvnw *)", "Bash(./mvnw.cmd *)", "Bash(cmd /c mvnw.cmd *)", "Bash(cd *)",
      "Bash(java *)", "Bash(javac *)", "Bash(python *)", "Bash(py *)", "Bash(ls *)", "Bash(cat *)", "Bash(head *)",
      "Bash(tail *)", "Bash(grep *)", "Bash(find *)", "Bash(mkdir *)", "Bash(wc *)", "Bash(diff *)", "Bash(sort *)",
      "PowerShell(git *)", "PowerShell(.\\mvnw.cmd *)", "PowerShell(./mvnw.cmd *)", "PowerShell(cd *)",
      "PowerShell(Get-ChildItem *)", "PowerShell(Get-Content *)", "PowerShell(New-Item *)", "PowerShell(java *)"
    ],
    "deny": ["WebFetch", "WebSearch"]
  },
  "taxonomy_extra": ["technology/java", "technology/cobol", "technology/spring", "technology/maven", "platform/windows", "technology/git", "concern/bug", "concern/constraint", "subject/tooling"],
  "app_checks": "app_checks.json",
  "events": "events.json",
  "ground_truth": "ground_truth.json",
  "quiz": "quiz.json"
}
