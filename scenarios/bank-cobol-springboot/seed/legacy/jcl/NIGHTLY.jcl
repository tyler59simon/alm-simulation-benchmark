//HPNIGHT  JOB (ACCT,'DEPOSITS'),'NIGHTLY BATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* HPST.PROD.NIGHTLY - DAILY DEPOSITS BATCH, ONE RUN PER CALENDAR DAY
//* CTLCARD HOLDS BUSINESS DATE YYDDD, SET BY SCHEDULER BEFORE SUBMIT
//* INTCALC ENDS RC=4 ON LAST DAY OF MONTH - STEPS 4-6 KEY OFF THAT
//*--------------------------------------------------------------------
//JOBLIB   DD DISP=SHR,DSN=HPST.PROD.LOADLIB
//*
//STEP010  EXEC PGM=XFERPROC
//CTLCARD  DD DISP=SHR,DSN=HPST.PROD.CTLCARD
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(0)
//ACCTOUT  DD DSN=HPST.PROD.ACCTMAST(+1),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//TXNIN    DD DISP=SHR,DSN=HPST.PROD.TXNIN.DAILY
//POSTED   DD DSN=HPST.PROD.POSTED.DAILY,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//REJECTS  DD DSN=HPST.PROD.REJECTS.DAILY,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=83,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=INTCALC,COND=(4,LT,STEP010)
//CTLCARD  DD DISP=SHR,DSN=HPST.PROD.CTLCARD
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(+1)
//ACCTOUT  DD DSN=HPST.PROD.ACCTMAST(+2),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//*
//  IF (STEP020.RC = 4) THEN
//STEP030  EXEC PGM=EODPOST
//CTLCARD  DD DISP=SHR,DSN=HPST.PROD.CTLCARD
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(+2)
//ACCTOUT  DD DSN=HPST.PROD.ACCTMAST(+3),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//POSTED   DD DISP=MOD,DSN=HPST.PROD.POSTED.DAILY
//SYSOUT   DD SYSOUT=*
//*
//STEP040  EXEC PGM=FEEASSES
//CTLCARD  DD DISP=SHR,DSN=HPST.PROD.CTLCARD
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(+3)
//ACCTOUT  DD DSN=HPST.PROD.ACCTMAST(+4),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//POSTED   DD DISP=MOD,DSN=HPST.PROD.POSTED.DAILY
//SYSOUT   DD SYSOUT=*
//*
//STEP050  EXEC PGM=STMTGEN
//CTLCARD  DD DISP=SHR,DSN=HPST.PROD.CTLCARD
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(+4)
//POSTED   DD DISP=SHR,DSN=HPST.PROD.POSTED.DAILY
//STMTOUT  DD DSN=HPST.PROD.STMT.D&YYMM,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(20,10),RLSE),
//             DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//  ENDIF
//*
//* STEP060 - ARCHIVE POSTED/REJECTS TO TAPE (RUNS ALWAYS)
//STEP060  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD DISP=SHR,DSN=HPST.PROD.POSTED.DAILY
//SYSUT2   DD DSN=HPST.PROD.POSTED.ARCH(+1),DISP=(NEW,CATLG),
//             UNIT=TAPE
//SYSIN    DD DUMMY
