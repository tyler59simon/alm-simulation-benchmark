//HPACMNT  JOB (ACCT,'DEPOSITS'),'ACCT MAINT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------------
//* ON-REQUEST ONLY. DO NOT RUN WHILE HPNIGHT IS ACTIVE (ENQ ON MASTER)
//* MNTREQ BUILT BY BRANCH OPS FROM FORM DP-114
//*--------------------------------------------------------------------
//JOBLIB   DD DISP=SHR,DSN=HPST.PROD.LOADLIB
//STEP010  EXEC PGM=ACCTMNT
//ACCTIN   DD DISP=SHR,DSN=HPST.PROD.ACCTMAST(0)
//ACCTOUT  DD DSN=HPST.PROD.ACCTMAST(+1),DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(30,10),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//MNTREQ   DD DISP=SHR,DSN=HPST.PROD.MNTREQ
//SYSOUT   DD SYSOUT=*
