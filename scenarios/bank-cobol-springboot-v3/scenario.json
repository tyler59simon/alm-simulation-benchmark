  "waves": [
    [
      "po",
      "arch",
      "la1",
      "la2"
    ],
    [
      "dev-acct",
      "dev-ledger",
      "dev-int",
      "dev-int2",
      "dev-pay",
      "mig"
    ],
    [
      "qa",
      "sec",
      "sec2",
      "ops"
    ]
  ],
  "seed": [
    [
      "seed/legacy",
      "legacy"
    ],
    [
      "seed/modern",
      "modern"
    ],
    [
      "seed/docs",
      "docs"
    ],
    [
      "seed/README.md",
      "README.md"
    ],
    [
      "seed/CLAUDE.md",
      "CLAUDE.md"
    ],
    [
      "seed/gitignore",
      ".gitignore"
    ]
  ],
  "keep_dirs": [
    "docs/handoff",
    "docs/incidents"
  ],
  "workspace": "workspace",
  "toolchain": {
    "env": {
      "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.13.9-hotspot",
      "MAVEN_OPTS": "-Xmx1g"
    },
    "path_prepend": [
      "C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.13.9-hotspot\\bin"
    ]
  },
  "prime": {
    "cwd": "modern",
    "command": [
      "cmd",
      "/c",
      ".\\mvnw.cmd",
      "-q",
      "-B",
      "dependency:go-offline"
    ],
    "timeout_min": 20
  },
  "ci": {
    "cwd": "modern",
    "command": [
      "cmd",
      "/c",
      ".\\mvnw.cmd",
      "-q",
      "-B",
      "verify"
    ],
    "timeout_min": 20,
    "tail_lines": 40
  },
  "lint": [
    {
      "id": "L1",
      "desc": "no System.out/System.err printing in production code; use the logger",
      "glob": "modern/**/src/main/java/**/*.java",
      "pattern": "System\\.(out|err)\\.print"
    },
    {
      "id": "L2",
      "desc": "TODO/FIXME must name its ticket, e.g. TODO(LH-123)",
      "glob": "modern/**/*.java",
      "pattern": "\\b(TODO|FIXME)\\b(?!\\(LH-\\d+\\))"
    }
  ],
  "tools": {
    "allow": [],
    "deny": [
      "WebFetch",
      "WebSearch"
    ]
  },
  "taxonomy_extra": [
    "technology/java",
    "technology/cobol",
    "technology/spring",
    "technology/maven",
    "platform/windows",
    "technology/git",
    "concern/bug",
    "concern/constraint",
    "subject/tooling"
  ],
  "app_checks": "app_checks.json",
  "events": "events.json",
  "ground_truth": "ground_truth.json",
  "quiz": "quiz.json",
  "probes": "probes.json",
  "grader_calibration": "grader_calibration.json",
  "mistakes": "mistakes.json",
  "decision_docs": [
    "docs/adr/ADR-*.md",
    "docs/business-rules.md",
    "docs/handoff/*.md",
    "docs/incidents/*.md"
  ]
}
