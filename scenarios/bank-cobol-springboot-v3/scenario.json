    {
      "id": "dev-ledger",
      "name": "Ben Kowalczyk",
      "title": "Developer",
      "owns": "the ledger module (posting, fees, statements)",
      "tier": "haiku",
      "briefing": "briefings/dev-ledger.md"
    },
    {
      "id": "dev-int",
