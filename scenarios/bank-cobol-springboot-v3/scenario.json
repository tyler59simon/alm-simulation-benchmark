{
  "name": "bank-cobol-springboot-v3",
  "description": "Realistic variant v3 (v2 plus time-gated colleague knowledge, a recurring tracker trap and stricter fact patterns): Harbor Point Savings & Trust modernizes its COBOL nightly batch to Java 21 / Spring Boot 3. Short engineer-voice prompts, conventions in the repo CLAUDE.md, tracker and wiki outside the repo, business colleagues on Slack, natural traps, two handovers and a vacation, 3 working days per sprint, work probes in sprint 4.",
  "domain": "bankmod",
  "sprints": 4,
  "days_per_sprint": 3,
  "parallel": 4,
  "session_timeout_min": 30,
  "spend_limit_usd": 60,
  "tiers": {
    "haiku": {
      "model": "haiku",
      "budget_usd": 1.5,
      "permission_mode": "bypassPermissions"
    },
    "sonnet-low": {
      "model": "sonnet",
      "effort": "low",
      "budget_usd": 3.0,
      "permission_mode": "bypassPermissions"
    },
    "grader": {
      "model": "sonnet",
      "budget_usd": 2.0
    }
  },
  "roster": [
    {
      "id": "po",
      "name": "Priya Okonkwo",
